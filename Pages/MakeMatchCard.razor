@page "/MakeMatchCard"
@inject IJSRuntime JSRuntime


<div class="container">
    <h3 class="mb-4">テニス乱数表生成ツール</h3>

    <!-- プレイヤー登録エリア -->
    <div class="card mb-4 p-3">
        <h5>プレイヤー追加</h5>
        <div class="input-group">
            <input @ref="playerNameInput" autofocus type="text" class="form-control" placeholder="プレイヤーを入力" @bind="newPlayerName" @onkeyup="HandleKeyUp" />
            <button class="btn btn-success" @onclick="AddPlayer">追加</button>
        </div>
    </div>

    <!-- プレイヤー一覧と対戦結果 -->
    <div class="row mb-4">
        <!-- 左側：プレイヤーリスト -->
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="card p-3 h-100">
                <h5>プレイヤー一覧 (参加中: @players.Count(p => p.Status == "active")人 / 総数: @players.Count 人)</h5>
                <ul class="list-group mt-2">
                    @for (int i = 0; i < players.Count; i++)
                    {
                        var index = i;
                        var p = players[index];
                        <li class="list-group-item d-flex justify-content-between align-items-center @(p.Status == "resting" ? "player-resting" : "")">
                            <div>
                                <span class="fw-bold">@p.Name</span>
                                <span class="badge bg-secondary ms-2">試合数: @p.MatchCount</span>
                            </div>
                            <div>
                                <button class="btn btn-sm me-2 @(p.Status == "resting" ? "btn-outline-secondary" : "btn-primary")" @onclick="() => ToggleStatus(index)">
                                    @(p.Status == "resting" ? "休憩中" : "参加中")
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemovePlayer(index)">削除</button>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>


        <!-- 設定エリア -->
        <div class="col-md-6">
            <div class="card p-3 h-100">
                <h5>条件設定</h5>

                <div class="my-2">
                    <label class="form-label d-block fw-bold mb-1" style="font-size: 0.9rem;">試合形式</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="matchType" id="doubles" value="doubles" checked="@(matchType == "doubles")" @onchange='() => matchType = "doubles"' />
                        <label class="form-check-label" for="doubles">ダブルス</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="matchType" id="singles" value="singles" checked="@(matchType == "singles")" @onchange='() => matchType = "singles"' />
                        <label class="form-check-label" for="singles">シングルス</label>
                    </div>
                </div>

                <div class="my-2">
                    <label class="form-label d-block fw-bold mb-1" style="font-size: 0.9rem;">生成モード</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="generationMode" id="singleMatch" value="single" checked="@(generationMode == "single")" @onchange='() => generationMode = "single"' />
                        <label class="form-check-label" for="singleMatch">1試合ずつ</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="generationMode" id="tenMatches" value="ten" checked="@(generationMode == "ten")" @onchange='() => generationMode = "ten"' />
                        <label class="form-check-label" for="tenMatches">10試合まとめて</label>
                    </div>
                </div>

                <div class="mb-3 d-flex align-items-end justify-content-between">
                    <div>
                        <label for="courtCount" class="form-label fw-bold mb-1" style="font-size: 0.9rem;">使用コート数</label>
                        <input type="number" class="form-control" id="courtCount" style="max-width: 80px;" @bind="courtCount" min="1" />
                    </div>

                    @if (players.Any())
                    {
                        <button class="btn btn-sm btn-link text-danger text-decoration-none mb-1" @onclick="ResetMatchCounts">
                            <i class="bi bi-trash"></i> 試合回数をリセット
                        </button>
                    }
                </div>

                <button class="btn btn-success w-100 mb-2" @onclick="GenerateMatches">
                    @(generationMode == "ten" ? "対戦表を10試合分生成" : "対戦表を生成")
                </button>

                @if (matchResults.Any())
                {
                    <button class="btn btn-outline-danger w-100" @onclick="UndoGeneration">直前の生成を取り消す</button>
                }

                <div class="card w-100 mt-2 border-0 bg-transparent">
                    <h5>対戦カード結果</h5>
                    <div class="w-100">
                        <div class="w-100">
                            @for (int i = 0; i < matchResults.Count; i++)
                            {
                                var index = i; // ラムダ式クロージャ対策のためのローカル変数コピー
                                var match = matchResults[index];

                                @if (!string.IsNullOrEmpty(match.RoundName))
                                {
                                    <h6 class="mt-3 text-primary fw-bold border-bottom pb-1">
                                        <i class="bi bi-collection-play"></i> @match.RoundName
                                    </h6>
                                }

                                <div class="match-box mb-2 shadow-sm p-2 border rounded bg-white d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="mb-1 text-muted" style="font-size: 0.85rem;">@match.CourtName</h6>
                                        <div class="fs-5">@((MarkupString)match.MatchText)</div>
                                    </div>

                                    <!-- 1試合につき1つのボタンだけを表示 -->
                                    <button class="btn btn-sm btn-primary" @onclick="() => CompleteMatch(index)">
                                        完了
                                    </button>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(restingMembersText))
                            {
                                <div class="alert alert-warning mt-3">
                                    <strong>@((generationMode == "ten") ? "10試合中一度もお呼びがかからなかった人:" : "今回のお休み:")</strong> @restingMembersText
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>



@code {
    // プレイヤーの型定義（C#のクラス）
    public class Player
    {
        public string Name { get; set; } = "";
        public int MatchCount { get; set; }
        public string Status { get; set; } = "active"; // active または resting
    }

    // コート結果の型定義
    public class MatchResultItem
    {
        public string RoundName { get; set; } = ""; // 💡【追加】「第1試合」などのラウンド名
        public string CourtName { get; set; } = "";
        public string MatchText { get; set; } = "";
        public List<string> ParticipantNames { get; set; } = new();

        // ★追加: 個別キャンセルされたかどうか
        public bool IsCanceled { get; set; } = false;
    }

    // ========================================
    // 1ラウンド分の仮の試合
    // ========================================
    private class RoundMatchCandidate
    {
        public List<Player> Participants { get; set; } = new();

        public List<string> Pairs { get; set; } = new();
    }

    // ========================================
    // 今回の10試合生成中の履歴
    // ========================================
    private class GenerationHistory
    {
        // 味方になった回数
        public Dictionary<string, int> PartnerCounts { get; set; } = new();

        // 対戦相手になった回数
        public Dictionary<string, int> OpponentCounts { get; set; } = new();

        // 完全に同じ対戦カードが出た回数
        public Dictionary<string, int> MatchupCounts { get; set; } = new();
    }

    // 画面で使う変数たち
    private List<Player> players = new List<Player>();
    private List<MatchResultItem> matchResults = new List<MatchResultItem>();
    private string newPlayerName = "";
    private string matchType = "doubles";
    private string generationMode = "ten";
    private int courtCount = 1;
    private string restingMembersText = "";
    private Random rand = new Random();
    private ElementReference playerNameInput;

    // 💡【追加】直前の試合数を一時的に保存しておくバックアップ用のリスト
    private List<int> matchCountBackup = new List<int>();
    private List<Player> lastSelectedPlayers = new List<Player>();

    // 起動時にデータを読み込む（JavaScriptのwindow.onloadに相当）
    protected override async Task OnInitializedAsync()
    {
        // サーバーサイドでの実行を防ぎ、ブラウザ側でのみ動かす（WASMスタンドアロン用）
        await Task.Delay(1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // 1. プレイヤーデータの復元
                var savedPlayers = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_players");
                if (!string.IsNullOrEmpty(savedPlayers))
                {
                    players = System.Text.Json.JsonSerializer.Deserialize<List<Player>>(savedPlayers) ?? new List<Player>();
                }

                // 2. 💡【追加】試合結果データの復元
                var savedMatches = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_matches");
                if (!string.IsNullOrEmpty(savedMatches))
                {
                    matchResults = System.Text.Json.JsonSerializer.Deserialize<List<MatchResultItem>>(savedMatches) ?? new List<MatchResultItem>();
                }

                // 3. 💡【追加】お休みメンバーテキストの復元
                var savedResting = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "tennis_resting");
                if (!string.IsNullOrEmpty(savedResting))
                {
                    restingMembersText = savedResting;
                }

                StateHasChanged(); // 画面を再描画
            }
            catch { }
        }
    }

    // データを保存する共通関数
    private async Task SaveData()
    {
        // 1. プレイヤーデータの保存
        var jsonPlayers = System.Text.Json.JsonSerializer.Serialize(players);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_players", jsonPlayers);

        // 2. 💡【追加】生成された試合結果の保存
        var jsonMatches = System.Text.Json.JsonSerializer.Serialize(matchResults);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_matches", jsonMatches);

        // 3. 💡【追加】お休みメンバーテキストの保存
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "tennis_resting", restingMembersText);
    }

    // プレイヤー追加
    private async Task AddPlayer()
    {
        var name = newPlayerName?.Trim();
        if (string.IsNullOrEmpty(name))
        {
            await JSRuntime.InvokeVoidAsync("alert", "名前を入力してください。");
            await playerNameInput.FocusAsync();
            return;
        }
        if (players.Any(p => p.Name == name))
        {
            await JSRuntime.InvokeVoidAsync("alert", "同じ名前のプレイヤーがいます。");
            newPlayerName = "";
            await playerNameInput.FocusAsync();
            return;
        }

        players.Insert(0, new Player { Name = name, MatchCount = 0, Status = "active" });
        newPlayerName = "";

        await SaveData();
        await playerNameInput.FocusAsync();
    }

    // エンターキーを検知
    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddPlayer();
    }

    // 参加・休憩の切り替え
    private async Task ToggleStatus(int index)
    {
        players[index].Status = players[index].Status == "active" ? "resting" : "active";

        // 【追加】参加(active)が上、休憩(resting)が下になるように並び替える
        players = players.OrderBy(p => p.Status == "resting").ToList();

        await SaveData();
    }

    // 削除
    private async Task RemovePlayer(int index)
    {
        players.RemoveAt(index);
        await SaveData();
    }

    private async Task ResetMatchCounts()
    {
        foreach (var p in players)
        {
            p.MatchCount = 0;
        }


        //SaveData内で「空のmatchResults」と「空のrestingMembersText」が保存されるため自動的にクリアされます
        await SaveData();
        StateHasChanged();
    }

    private async Task UndoGeneration()
    {
        if (!matchResults.Any()) return;

        // 生成時のカウント加算を行っていないため、カウントを減らす必要はありません。
        // 画面上に残っている未消化の試合結果と案内テキストをクリアするだけで完了です。
        matchResults.Clear();
        restingMembersText = "";

        // 変更状態を保存
        await SaveData();
    }

    // 試合消化（完了）ボタンの処理
    private async Task CompleteMatch(int index)
    {
        // インデックスの有効性チェック
        if (index < 0 || index >= matchResults.Count) return;

        var targetMatch = matchResults[index];

        // 1. 試合の参加者の MatchCount を加算
        if (targetMatch.ParticipantNames != null)
        {
            foreach (var pName in targetMatch.ParticipantNames)
            {
                var player = players.FirstOrDefault(p => p.Name == pName);
                if (player != null)
                {
                    player.MatchCount++; // ここでカウントを増やす
                }
            }
        }

        // 2. 完了した試合を画面リストから取り除く場合
        matchResults.RemoveAt(index);

        // 3. データ保存と画面の再描画
        await SaveData();
        StateHasChanged(); // 必要に応じて画面を強制再描画
    }

    private async Task GenerateMatches()
    {
        int requiredPlayersPerCourt =
            matchType == "doubles" ? 4 : 2;

        var activePool = players
            .Where(p => p.Status == "active")
            .ToList();

        int totalRequiredPlayers =
            courtCount * requiredPlayersPerCourt;

        if (activePool.Count < totalRequiredPlayers)
        {
            await JSRuntime.InvokeVoidAsync(
                "alert",
                $"参加中のプレイヤーが足りません。最低 {totalRequiredPlayers} 人必要です。" +
                $"(現在参加中: {activePool.Count}人)"
            );

            return;
        }

        // 現在の実試合数をバックアップ
        matchCountBackup = players
            .Select(p => p.MatchCount)
            .ToList();

        lastSelectedPlayers =
            new List<Player>(activePool);

        matchResults.Clear();
        restingMembersText = "";

        int loopCount = generationMode switch
        {
            "ten" => 10,
            "five" => 5,
            _ => 1
        };

        // ========================================
        // 生成中だけ使用する仮想試合数
        // ========================================
        var virtualMatchCounts = activePool
            .ToDictionary(
                p => p.Name,
                p => p.MatchCount
            );

        // ========================================
        // 前ラウンドの出場状況
        // ========================================
        var previousPlayed = activePool
            .ToDictionary(
                p => p.Name,
                p => false
            );

        bool hasPreviousRound = false;

        // ========================================
        // 生成中の履歴
        // ========================================
        var history = new GenerationHistory();

        // 一度でも選ばれた人
        var allSelectedInSession =
            new HashSet<string>();

        for (int round = 1; round <= loopCount; round++)
        {
            var bestRound = FindBestRound(
                activePool,
                virtualMatchCounts,
                previousPlayed,
                hasPreviousRound,
                history,
                totalRequiredPlayers,
                requiredPlayersPerCourt
            );

            if (bestRound == null)
            {
                await JSRuntime.InvokeVoidAsync(
                    "alert",
                    $"第{round}試合の組み合わせを作成できませんでした。\n" +
                    "参加人数・コート数を確認してください。"
                );

                break;
            }

            // ========================================
            // 今回選ばれた人
            // ========================================
            var selectedNames = bestRound
                .SelectMany(m => m.Participants)
                .Select(p => p.Name)
                .ToHashSet();

            foreach (var name in selectedNames)
            {
                allSelectedInSession.Add(name);

                virtualMatchCounts[name]++;
            }

            // ========================================
            // 今回の出場状態
            // ========================================
            var currentPlayed = activePool
                .ToDictionary(
                    p => p.Name,
                    p => selectedNames.Contains(p.Name)
                );

            // ========================================
            // 表示用カードを作る
            // ========================================
            for (int court = 0;
                 court < bestRound.Count;
                 court++)
            {
                var roundMatch = bestRound[court];

                var item = new MatchResultItem();

                if (loopCount > 1 && court == 0)
                {
                    item.RoundName =
                        $"第 {round} 試合";
                }

                item.CourtName =
                    $"コート {court + 1}";

                string amp =
                    "<small style='color: #888888;'> & </small>";

                string vs =
                    "<small style='color: #888888;'>vs</small>";

                if (matchType == "doubles")
                {
                    var p1 = roundMatch.Participants[0];
                    var p2 = roundMatch.Participants[1];
                    var p3 = roundMatch.Participants[2];
                    var p4 = roundMatch.Participants[3];

                    item.ParticipantNames =
                        new List<string>
                        {
                        p1.Name,
                        p2.Name,
                        p3.Name,
                        p4.Name
                        };

                    item.MatchText =
                        $"{p1.Name}{amp}{p2.Name} " +
                        $"{vs} " +
                        $"{p3.Name}{amp}{p4.Name}";
                }
                else
                {
                    var p1 = roundMatch.Participants[0];
                    var p2 = roundMatch.Participants[1];

                    item.ParticipantNames =
                        new List<string>
                        {
                        p1.Name,
                        p2.Name
                        };

                    item.MatchText =
                        $"{p1.Name} {vs} {p2.Name}";
                }

                matchResults.Add(item);
            }

            // ========================================
            // このラウンドを履歴に登録
            // ========================================
            RegisterRoundHistory(
                bestRound,
                history
            );

            previousPlayed = currentPlayed;
            hasPreviousRound = true;
        }

        // ========================================
        // 10試合中、一度も出なかった人
        // ========================================
        var restingInActivePool = activePool
            .Where(p =>
                !allSelectedInSession.Contains(p.Name))
            .Select(p => p.Name)
            .ToList();

        restingMembersText =
            restingInActivePool.Count > 0
                ? string.Join(", ", restingInActivePool)
                : "";

        await SaveData();
    }
    //ペアを判定するメゾット
    private string GetPairKey(string player1, string player2)
    {
        if (string.Compare(
                player1,
                player2,
                StringComparison.Ordinal) < 0)
        {
            return $"{player1}|{player2}";
        }

        return $"{player2}|{player1}";
    }

    // ========================================
    // 完全な対戦カードを同一判定する
    //
    // A&B vs C&D
    // B&A vs D&C
    // C&D vs A&B
    //
    // はすべて同じものとして扱う
    // ========================================
    private string GetMatchupKey(
        string p1,
        string p2,
        string p3,
        string p4)
    {
        string team1 = GetPairKey(p1, p2);
        string team2 = GetPairKey(p3, p4);

        if (string.Compare(
            team1,
            team2,
            StringComparison.Ordinal) < 0)
        {
            return $"{team1}||{team2}";
        }

        return $"{team2}||{team1}";
    }


    // ========================================
    // Dictionaryの履歴回数取得
    // ========================================
    private int GetHistoryCount(
        Dictionary<string, int> dictionary,
        string key)
    {
        return dictionary.TryGetValue(
            key,
            out int count)
                ? count
                : 0;
    }


    // ========================================
    // Dictionaryの履歴を+1
    // ========================================
    private void AddHistoryCount(
        Dictionary<string, int> dictionary,
        string key)
    {
        if (dictionary.ContainsKey(key))
        {
            dictionary[key]++;
        }
        else
        {
            dictionary[key] = 1;
        }
    }


    // ========================================
    // 確定した1ラウンドを履歴へ登録
    // ========================================
    private void RegisterRoundHistory(
        List<RoundMatchCandidate> round,
        GenerationHistory history)
    {
        foreach (var match in round)
        {
            if (matchType == "doubles")
            {
                var p1 = match.Participants[0].Name;
                var p2 = match.Participants[1].Name;
                var p3 = match.Participants[2].Name;
                var p4 = match.Participants[3].Name;

                // ----------------------------
                // 味方ペア
                // ----------------------------
                AddHistoryCount(
                    history.PartnerCounts,
                    GetPairKey(p1, p2));

                AddHistoryCount(
                    history.PartnerCounts,
                    GetPairKey(p3, p4));

                // ----------------------------
                // 対戦相手
                // ----------------------------
                AddHistoryCount(
                    history.OpponentCounts,
                    GetPairKey(p1, p3));

                AddHistoryCount(
                    history.OpponentCounts,
                    GetPairKey(p1, p4));

                AddHistoryCount(
                    history.OpponentCounts,
                    GetPairKey(p2, p3));

                AddHistoryCount(
                    history.OpponentCounts,
                    GetPairKey(p2, p4));

                // ----------------------------
                // 完全な対戦カード
                // ----------------------------
                AddHistoryCount(
                    history.MatchupCounts,
                    GetMatchupKey(
                        p1, p2, p3, p4));
            }
            else
            {
                var p1 =
                    match.Participants[0].Name;

                var p2 =
                    match.Participants[1].Name;

                // シングルスでは対戦履歴として記録
                AddHistoryCount(
                    history.OpponentCounts,
                    GetPairKey(p1, p2));
            }
        }
    }

    // ========================================
    // 1ラウンドの最適な組み合わせを探す
    // ========================================
    private List<RoundMatchCandidate>? FindBestRound(
        List<Player> activePool,
        Dictionary<string, int> virtualMatchCounts,
        Dictionary<string, bool> previousPlayed,
        bool hasPreviousRound,
        GenerationHistory history,
        int totalRequiredPlayers,
        int requiredPlayersPerCourt)
    {
        List<RoundMatchCandidate>? bestRound = null;

        double bestScore = double.MaxValue;

        // 人数が多い場合でも候補を十分探す
        const int attempts = 1500;

        for (int attempt = 0;
             attempt < attempts;
             attempt++)
        {
            // ========================================
            // 出場候補を作る
            // ========================================

            List<Player> selectedPlayers;

            if (hasPreviousRound &&
                activePool.Count > totalRequiredPlayers)
            {
                var previousPlayers = activePool
                    .Where(p =>
                        previousPlayed[p.Name])
                    .ToList();

                var previousRestPlayers = activePool
                    .Where(p =>
                        !previousPlayed[p.Name])
                    .ToList();

                int restCount =
                    activePool.Count -
                    totalRequiredPlayers;

                // ------------------------------------
                // 基本は2人交代
                //
                // 休憩が1人しかいなければ1人交代
                // ------------------------------------
                int changeCount =
                    Math.Min(
                        2,
                        Math.Min(
                            restCount,
                            previousRestPlayers.Count));

                // 前回休みだった人を優先して入れる
                var entering = previousRestPlayers
                    .OrderBy(p =>
                        virtualMatchCounts[p.Name])
                    .ThenBy(_ => rand.Next())
                    .Take(changeCount)
                    .ToList();

                // 前回出場者から同じ人数を外す
                // 試合数が多い人を少し優先して休ませる
                var leaving = previousPlayers
                    .OrderByDescending(p =>
                        virtualMatchCounts[p.Name])
                    .ThenBy(_ => rand.Next())
                    .Take(changeCount)
                    .Select(p => p.Name)
                    .ToHashSet();

                selectedPlayers = previousPlayers
                    .Where(p =>
                        !leaving.Contains(p.Name))
                    .Concat(entering)
                    .ToList();

                // 念のため人数不足を補う
                if (selectedPlayers.Count <
                    totalRequiredPlayers)
                {
                    var alreadySelected =
                        selectedPlayers
                            .Select(p => p.Name)
                            .ToHashSet();

                    var extra = activePool
                        .Where(p =>
                            !alreadySelected.Contains(
                                p.Name))
                        .OrderBy(p =>
                            virtualMatchCounts[p.Name])
                        .ThenBy(_ => rand.Next())
                        .Take(
                            totalRequiredPlayers -
                            selectedPlayers.Count);

                    selectedPlayers.AddRange(extra);
                }
            }
            else
            {
                // 第1試合
                selectedPlayers = activePool
                    .OrderBy(p =>
                        virtualMatchCounts[p.Name])
                    .ThenBy(_ => rand.Next())
                    .Take(totalRequiredPlayers)
                    .ToList();
            }

            if (selectedPlayers.Count !=
                totalRequiredPlayers)
            {
                continue;
            }

            // ========================================
            // 選ばれた人を各コートへ割り当てる
            // ========================================

            selectedPlayers =
                selectedPlayers
                    .OrderBy(_ => rand.Next())
                    .ToList();

            var result =
                new List<RoundMatchCandidate>();

            bool failed = false;

            var remaining =
                new List<Player>(selectedPlayers);

            for (int court = 0;
                 court < courtCount;
                 court++)
            {
                if (remaining.Count <
                    requiredPlayersPerCourt)
                {
                    failed = true;
                    break;
                }

                RoundMatchCandidate? bestMatch = null;
                double bestMatchScore =
                    double.MaxValue;

                // このコートの組み合わせを何度も試す
                for (int x = 0; x < 250; x++)
                {
                    var group = remaining
                        .OrderBy(_ => rand.Next())
                        .Take(requiredPlayersPerCourt)
                        .ToList();

                    if (group.Count !=
                        requiredPlayersPerCourt)
                    {
                        continue;
                    }

                    double matchScore = 0;

                    if (matchType == "doubles")
                    {
                        var p1 = group[0];
                        var p2 = group[1];
                        var p3 = group[2];
                        var p4 = group[3];

                        string pair1 =
                            GetPairKey(
                                p1.Name,
                                p2.Name);

                        string pair2 =
                            GetPairKey(
                                p3.Name,
                                p4.Name);

                        // ============================
                        // 同じ味方ペアへのペナルティ
                        // ============================

                        int pair1Count =
                            GetHistoryCount(
                                history.PartnerCounts,
                                pair1);

                        int pair2Count =
                            GetHistoryCount(
                                history.PartnerCounts,
                                pair2);

                        matchScore +=
                            pair1Count * 600;

                        matchScore +=
                            pair2Count * 600;

                        // ============================
                        // 対戦相手の重複
                        // ============================

                        string[] opponentKeys =
                        {
                        GetPairKey(
                            p1.Name, p3.Name),

                        GetPairKey(
                            p1.Name, p4.Name),

                        GetPairKey(
                            p2.Name, p3.Name),

                        GetPairKey(
                            p2.Name, p4.Name)
                    };

                        foreach (var key
                                 in opponentKeys)
                        {
                            int opponentCount =
                                GetHistoryCount(
                                    history.OpponentCounts,
                                    key);

                            // 未対戦なら加点なし
                            // 対戦済みならペナルティ
                            matchScore +=
                                opponentCount * 180;
                        }

                        // ============================
                        // 完全に同じ対戦カード
                        // ============================

                        string matchupKey =
                            GetMatchupKey(
                                p1.Name,
                                p2.Name,
                                p3.Name,
                                p4.Name);

                        int matchupCount =
                            GetHistoryCount(
                                history.MatchupCounts,
                                matchupKey);

                        // 完全重複はかなり避ける
                        matchScore +=
                            matchupCount * 2000;

                        // 少し乱数を入れて
                        // 毎回同じ結果になりすぎないようにする
                        matchScore +=
                            rand.NextDouble() * 5;

                        if (matchScore <
                            bestMatchScore)
                        {
                            bestMatchScore =
                                matchScore;

                            bestMatch =
                                new RoundMatchCandidate
                                {
                                    Participants =
                                        group,

                                    Pairs =
                                        new List<string>
                                        {
                                        pair1,
                                        pair2
                                        }
                                };
                        }
                    }
                    else
                    {
                        var p1 = group[0];
                        var p2 = group[1];

                        string opponentKey =
                            GetPairKey(
                                p1.Name,
                                p2.Name);

                        int opponentCount =
                            GetHistoryCount(
                                history.OpponentCounts,
                                opponentKey);

                        matchScore +=
                            opponentCount * 1000;

                        matchScore +=
                            rand.NextDouble() * 5;

                        if (matchScore <
                            bestMatchScore)
                        {
                            bestMatchScore =
                                matchScore;

                            bestMatch =
                                new RoundMatchCandidate
                                {
                                    Participants =
                                        group,

                                    Pairs =
                                        new List<string>
                                        {
                                        opponentKey
                                        }
                                };
                        }
                    }
                }

                if (bestMatch == null)
                {
                    failed = true;
                    break;
                }

                result.Add(bestMatch);

                var usedNames =
                    bestMatch.Participants
                        .Select(p => p.Name)
                        .ToHashSet();

                remaining = remaining
                    .Where(p =>
                        !usedNames.Contains(p.Name))
                    .ToList();
            }

            if (failed)
                continue;

            // ========================================
            // ラウンド全体の評価
            // ========================================
            double score =
                CalculateRoundScore(
                    result,
                    activePool,
                    virtualMatchCounts,
                    previousPlayed,
                    hasPreviousRound,
                    history,
                    totalRequiredPlayers
                );

            if (score < bestScore)
            {
                bestScore = score;
                bestRound = result;
            }
        }

        return bestRound;
    }


    // ========================================
    // ラウンド全体の評価
    //
    // 点数が低いほど良い
    // ========================================
    private double CalculateRoundScore(
        List<RoundMatchCandidate> round,
        List<Player> activePool,
        Dictionary<string, int> virtualMatchCounts,
        Dictionary<string, bool> previousPlayed,
        bool hasPreviousRound,
        GenerationHistory history,
        int totalRequiredPlayers)
    {
        var currentPlayed = round
            .SelectMany(x => x.Participants)
            .Select(x => x.Name)
            .ToHashSet();

        double score = 0;

        // ========================================
        // ① 試合回数を均等にする
        // ========================================

        var counts = activePool
            .Select(p =>
            {
                int count =
                    virtualMatchCounts[p.Name];

                if (currentPlayed.Contains(p.Name))
                    count++;

                return count;
            })
            .ToList();

        int maxCount = counts.Max();
        int minCount = counts.Min();

        score +=
            (maxCount - minCount) * 500;


        // ========================================
        // ② 2人交代を最優先
        // ========================================

        if (hasPreviousRound &&
            activePool.Count > totalRequiredPlayers)
        {
            int restCount =
                activePool.Count -
                totalRequiredPlayers;

            int targetChange =
                Math.Min(2, restCount);

            int enteredCount =
                activePool.Count(p =>
                    !previousPlayed[p.Name] &&
                    currentPlayed.Contains(p.Name));

            int leftCount =
                activePool.Count(p =>
                    previousPlayed[p.Name] &&
                    !currentPlayed.Contains(p.Name));

            // 2人交代から外れると大きなペナルティ
            score +=
                Math.Abs(
                    enteredCount -
                    targetChange) * 5000;

            score +=
                Math.Abs(
                    leftCount -
                    targetChange) * 5000;
        }


        // ========================================
        // ③ 連続出場
        // ========================================

        if (hasPreviousRound)
        {
            foreach (var player in activePool)
            {
                bool nowPlaying =
                    currentPlayed.Contains(
                        player.Name);

                bool playedLast =
                    previousPlayed[player.Name];

                if (nowPlaying && playedLast)
                {
                    score += 20;
                }
            }
        }


        // ========================================
        // ④ 連続休憩を強く避ける
        // ========================================

        if (hasPreviousRound)
        {
            foreach (var player in activePool)
            {
                bool nowPlaying =
                    currentPlayed.Contains(
                        player.Name);

                bool playedLast =
                    previousPlayed[player.Name];

                if (!nowPlaying &&
                    !playedLast)
                {
                    score += 700;
                }

                // 前回休み → 今回出場を優先
                if (nowPlaying &&
                    !playedLast)
                {
                    score -= 150;
                }
            }
        }


        // ========================================
        // ⑤ ラウンド全体でのペア・対戦履歴
        // ========================================

        foreach (var match in round)
        {
            if (matchType == "doubles")
            {
                var p1 =
                    match.Participants[0].Name;

                var p2 =
                    match.Participants[1].Name;

                var p3 =
                    match.Participants[2].Name;

                var p4 =
                    match.Participants[3].Name;

                // 味方ペア
                score +=
                    GetHistoryCount(
                        history.PartnerCounts,
                        GetPairKey(p1, p2))
                    * 600;

                score +=
                    GetHistoryCount(
                        history.PartnerCounts,
                        GetPairKey(p3, p4))
                    * 600;

                // 対戦相手
                string[] opponents =
                {
                GetPairKey(p1, p3),
                GetPairKey(p1, p4),
                GetPairKey(p2, p3),
                GetPairKey(p2, p4)
            };

                foreach (var opponent
                         in opponents)
                {
                    score +=
                        GetHistoryCount(
                            history.OpponentCounts,
                            opponent)
                        * 180;
                }

                // 完全同一カード
                score +=
                    GetHistoryCount(
                        history.MatchupCounts,
                        GetMatchupKey(
                            p1,
                            p2,
                            p3,
                            p4))
                    * 2000;
            }
            else
            {
                var p1 =
                    match.Participants[0].Name;

                var p2 =
                    match.Participants[1].Name;

                score +=
                    GetHistoryCount(
                        history.OpponentCounts,
                        GetPairKey(p1, p2))
                    * 1000;
            }
        }

        return score;
    }

    private async Task CompleteMatches()
    {
        if (!matchResults.Any()) return;

        // 表示されている全試合の参加者のMatchCountを確定加算
        foreach (var match in matchResults)
        {
            if (match.ParticipantNames != null)
            {
                foreach (var pName in match.ParticipantNames)
                {
                    var p = players.FirstOrDefault(player => player.Name == pName);
                    if (p != null)
                    {
                        p.MatchCount++;
                    }
                }
            }
        }

        // 消化完了したため画面の結果をクリア
        matchResults.Clear();
        restingMembersText = "";

        await SaveData();
    }
}
